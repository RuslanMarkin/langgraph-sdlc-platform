# Model provider: openai or deepseek. Not needed for the built-in smoke check.
MODEL_PROVIDER=deepseek

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Human approval interface: terminal or github.
APPROVAL_CHANNEL=github
GITHUB_TOKEN=
GITHUB_REPOSITORY=RuslanMarkin/CRM_Almaz
GITHUB_APPROVAL_POLL_SECONDS=10

# Постоянное состояние event-driven runner для GitHub Actions.
SDLC_DATABASE_URL=

# Langfuse Cloud project keys. Create them in the Langfuse project settings.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
